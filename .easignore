# EAS Build ignore file
# Reduce upload size by excluding unnecessary files

# Node modules (will be installed on build server)
node_modules/

# Build outputs - CRITICAL: These are huge!
android/app/build/
android/.gradle/
android/build/
android/.kotlin/
android/app/.cxx/
outputs/
dist/
g/
build/
.gradle/

# APK/AAB files
*.apk
*.aab
*.apks

# Java heap dumps (crash dumps)
*.hprof
java_pid*.hprof
android/*.hprof
android/java_pid*.hprof
**/*.hprof

# Local archives (often very large)
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# Explicit local artifact
mavrixfy-playstore.tar.gz

# Gradle cache directories
.gradle/
.gradle-build/
g/
.gradle-local/
.gradle-local-*/
.gradle-user-home/
.android-user-home/
.gradle-home/
.gradle-home-build*/

# Examples and test resources
examples/
.idea/
.vscode/
tools/
stitch_exports/
*.iml

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test files
__tests__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Documentation
*.md
docs/

# Git
.git/
.gitignore
.gitattributes

# Temporary files
*.tmp
*.temp
.cache/
.expo/
.expo-shared/
attached_assets/

# Local environment files and credentials (use EAS Secrets instead)
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.pem
*.key
*service-account*.json
firebase-service-account.json
app.aab.json
