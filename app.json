{
  "expo": {
    "name": "Mavrixfy",
    "slug": "mavrixfy",
    "version": "2.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/mavrixfy_icone.png",
    "scheme": "mavrixfy",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/mavrixfy_icone.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/mavrixfy_icon_ios.png",
      "bundleIdentifier": "com.mavrixfy.app",
      "buildNumber": "20500",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "This app may use the microphone for voice features.",
        "NSCameraUsageDescription": "This app uses the camera to upload profile pictures.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload images.",
        "NSAppleMusicUsageDescription": "This app streams music content.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mavrixfy.app",
      "versionCode": 20500,
      "googleServicesFile": "./android/app/google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/mavrixfy_icone.png",
        "backgroundColor": "#121212"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "enableDangerousExperimentalLeanBuilds": true,
      "navigationBar": {
        "backgroundColor": "#000000",
        "barStyle": "light-content",
        "visible": true
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-system-ui",
      [
        "expo-updates",
        {
          "username": "satvik1234"
        }
      ],
      "./plugins/withTrackPlayer",
      "./plugins/withIOSAVPlayer",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "targetSdkVersion": 35,
            "compileSdkVersion": 35,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableProguardInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.hermes.unicode.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class com.doublesymmetry.** { *; }\n-keep class expo.modules.updates.** { *; }\n-keep class kotlin.** { *; }\n-keep class kotlin.reflect.** { *; }",
            "useLegacyPackaging": false,
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so"
              ],
              "exclude": [
                "META-INF/*.kotlin_module"
              ]
            },
            "enableMinifyInReleaseBuilds": true,
            "usesCleartextTraffic": false
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-brightness",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "updates": {
      "url": "https://u.expo.dev/93293119-93b7-4dbb-acdd-7241771254c4",
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "2.5.0",
    "extra": {
      "domain": "spotify-api-drab.vercel.app",
      "firebaseApiKey": "AIzaSyBWgv_mE8ZAnG2kUJSacCOUgkbo1RxxSpE",
      "firebaseAuthDomain": "spotify-8fefc.firebaseapp.com",
      "firebaseProjectId": "spotify-8fefc",
      "firebaseStorageBucket": "spotify-8fefc.firebasestorage.app",
      "firebaseMessagingSenderId": "816396705670",
      "firebaseAppId": "1:816396705670:web:005e724df7139772521607",
      "firebaseMeasurementId": "G-FQJS8LREP5",
      "eas": {
        "projectId": "93293119-93b7-4dbb-acdd-7241771254c4"
      }
    },
    "owner": "satvik1234"
  }
}
