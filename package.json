{
  "name": "expo-app",
  "main": "index.js",
  "version": "3.2.0",
  "scripts": {
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "start": "npx expo start",
    "start:expo-go": "npx expo start",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:apk": "cd android && gradlew.bat assembleRelease",
    "build:aab:local": "cd android && gradlew.bat bundleRelease",
    "build:eas": "npx eas build --platform android --profile production",
    "build:ios:ipa": "npx eas build --platform ios --profile ios-ipa",
    "build:aab": "npx eas build --platform android --profile production-aab",
    "update:production": "npx eas update --branch production",
    "update:preview": "npx eas update --branch preview",
    "firestore:deploy:indexes": "npx firebase-tools deploy --only firestore:indexes",
    "firestore:deploy:rules": "npx firebase-tools deploy --only firestore:rules",
    "storage:deploy:rules": "npx firebase-tools deploy --only storage",
    "doctor": "npx react-doctor@latest --max-duration 15",
    "verify:ios": "pwsh -File scripts/verify-ios-config.ps1",
    "festival": "npx tsx scripts/switch-festival.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.20",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.17",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-screen-orientation": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-tracking-transparency": "~57.0.1",
    "expo-updates": "~57.0.21",
    "expo-video": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.16.0",
    "jpeg-js": "^0.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "16.3.3",
    "react-native-image-colors": "^2.6.0",
    "react-native-paper": "^5.15.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-track-player": "^4.1.2",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-native-youtube-iframe": "^2.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.4",
    "@typescript-eslint/parser": "^8.58.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": true,
        "exclude": [
          "react-native-track-player"
        ],
        "listUnknownPackages": true
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "@xmldom/xmldom": "0.8.13",
    "fast-uri": "3.1.5",
    "postcss": "8.5.10",
    "protobufjs": "7.6.4",
    "shell-quote": "1.8.4",
    "undici": "^6.28.0"
  },
  "private": true
}
