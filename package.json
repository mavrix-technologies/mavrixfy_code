{
  "name": "expo-app",
  "main": "index.js",
  "version": "3.5.0",
  "scripts": {
    "icons:generate": "node scripts/generate-app-icons.cjs",
    "icons:preview": "node scripts/generate-launch-preview.cjs",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "start": "npx expo start --dev-client",
    "start:expo-go": "npx expo start --go",
    "start:dev-client": "npx expo start --dev-client",
    "youtube:build-token": "node scripts/build-youtube-po-token.mjs",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:apk": "cd android && gradlew.bat assembleRelease",
    "build:aab:local": "cd android && gradlew.bat bundleRelease",
    "build:eas": "npx eas build --platform android --profile production",
    "build:ios:ipa": "npx eas build --platform ios --profile ios-ipa",
    "build:aab": "npx eas build --platform android --profile production-aab",
    "build:playstore:aab": "npx eas build --platform android --profile playstore-aab",
    "update:production": "npx eas update --branch production",
    "update:preview": "npx eas update --branch preview",
    "firestore:deploy:indexes": "npx firebase-tools deploy --only firestore:indexes",
    "firestore:deploy:rules": "npx firebase-tools deploy --only firestore:rules",
    "storage:deploy:rules": "npx firebase-tools deploy --only storage",
    "doctor": "npx react-doctor@latest --max-duration 15",
    "festival": "npx tsx scripts/switch-festival.ts",
    "showcase": "node scripts/deploy-app-showcase-firestore.cjs",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --test scripts/*.regression.test.cjs",
    "liked:backfill": "node scripts/backfill-liked-youtube.mjs",
    "liked:simplify": "node scripts/simplify-liked-song-fields.mjs",
    "functions:deploy": "npx firebase-tools deploy --only functions:offline-licenses"
  },
  "dependencies": {
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.101.4",
    "event-target-shim": "6.0.2",
    "expo": "~58.0.19",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-battery": "~58.0.3",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-screen-orientation": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-tracking-transparency": "~58.0.2",
    "expo-updates": "~58.0.18",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "firebase": "^12.16.0",
    "jintr": "3.3.1",
    "jpeg-js": "^0.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-draggable-flatlist": "4.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "16.3.3",
    "react-native-image-colors": "^2.6.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "youtubei.js": "^18.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/parser": "^8.58.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "bgutils-js": "4.0.3",
    "esbuild": "0.25.12",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": true,
        "exclude": [
          "mavrixfy-playback"
        ],
        "listUnknownPackages": true
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "@xmldom/xmldom": "0.8.13",
    "fast-uri": "3.1.5",
    "postcss": "8.5.10",
    "protobufjs": "7.6.4",
    "shell-quote": "1.8.4",
    "undici": "^6.28.0"
  },
  "private": true
}
