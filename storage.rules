rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // User profile images: readable by signed-in users, writable only by owner (max 5MB, images only)
    match /users/{userId}/profile/{allImages=**} {
      allow read: if signedIn();
      allow write: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Playlist cover images: readable by signed-in users, writable by authenticated users (max 5MB, images only)
    match /playlists/{playlistId}/{allImages=**} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny all other unmatched paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
