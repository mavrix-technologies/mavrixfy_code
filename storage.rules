rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsPlaylist(playlistId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/playlists/$(playlistId))
        && (
          firestore.get(/databases/(default)/documents/playlists/$(playlistId)).data.createdBy.get('id', '') == request.auth.uid
          || firestore.get(/databases/(default)/documents/playlists/$(playlistId)).data.createdBy.get('uid', '') == request.auth.uid
          || firestore.get(/databases/(default)/documents/playlists/$(playlistId)).data.createdBy.get('_id', '') == request.auth.uid
        );
    }

    // User profile images: readable by signed-in users, writable only by owner (max 5MB, images only)
    match /users/{userId}/profile/{allImages=**} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    // Playlist cover images: only the playlist creator can change them.
    match /playlists/{playlistId}/{allImages=**} {
      allow read: if signedIn();
      allow create, update: if ownsPlaylist(playlistId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if ownsPlaylist(playlistId);
    }

    // Deny all other unmatched paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
