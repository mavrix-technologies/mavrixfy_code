{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./src/*",
        "./*"
      ],
      "@src/*": [
        "./src/*"
      ],
      "@features/*": [
        "./src/features/*",
        "./features/*"
      ],
      "@shared/*": [
        "./src/shared/*",
        "./shared/*"
      ],
      "@domain/*": [
        "./src/domain/*"
      ],
      "@data/*": [
        "./src/data/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "server"
  ]
}
